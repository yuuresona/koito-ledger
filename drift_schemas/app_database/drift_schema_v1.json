    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL, \"entry_type\" INTEGER NOT NULL CHECK (entry_type IN (0, 1)), \"parent_id\" INTEGER NULL REFERENCES categories (id) ON DELETE RESTRICT, \"created_at_micros\" INTEGER NOT NULL, \"updated_at_micros\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "ledger_transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger_transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_cents\" INTEGER NOT NULL CHECK (amount_cents > 0 AND amount_cents <= 99999999999), \"date_epoch_day\" INTEGER NOT NULL, \"entry_type\" INTEGER NOT NULL CHECK (entry_type IN (0, 1)), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"subcategory_id\" INTEGER NULL REFERENCES categories (id) ON DELETE RESTRICT, \"note\" TEXT NULL, \"created_at_micros\" INTEGER NOT NULL, \"updated_at_micros\" INTEGER NOT NULL);"
        }
      ]
    },
